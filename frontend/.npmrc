# Install-script policy (explicit, per node-supply-chain skill):
# ignore-scripts=true would break this repo's dev flow — it also skips our OWN
# lifecycle scripts: `prepare` (husky git hooks) and msw's postinstall, which
# keeps public/mockServiceWorker.js in sync with the installed msw version.
# Documented exception: dependency lifecycle scripts stay enabled until the
# npm 12 per-package allowlist (npm approve-scripts) is available here.
ignore-scripts=false
