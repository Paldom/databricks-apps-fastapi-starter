# Generated from backend/app/core/config.py (make generate); edit the Settings class, not this file.
# Local development: copy to backend/.env. On Databricks Apps the bundle sets these (resources/fastapi_app.app.yml)
# and the platform injects PGHOST/PGPORT/PGDATABASE/PGUSER/PGSSLMODE, DATABRICKS_HOST and the
# app credentials; leave DATABASE_URL and the DATABRICKS_* auth variables unset there.
# The PG* values below match backend/docker-compose.yml (make dev-db); an empty value means unset.

SERVING_ENDPOINT_NAME=
JOB_ID=
DATABRICKS_HOST=
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
PGHOST=localhost
PGPORT=5432
PGDATABASE=mydb
PGUSER=myuser
PGPASSWORD=mypassword  # pragma: allowlist secret
PGSSLMODE=disable
DATABASE_URL=
DB_SCHEMA=app
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=3000
ENVIRONMENT=development
APP_VERSION=
DATABRICKS_APP_NAME=
ENABLE_EXAMPLES=false
CORS_ALLOW_ORIGINS=[]
VECTOR_SEARCH_ENDPOINT_NAME=
VECTOR_SEARCH_INDEX_NAME=
DATABRICKS_TOKEN=
LOG_LEVEL=INFO
VOLUME_ROOT=/Volumes/main/default
ENABLE_OBO=false
ENABLE_DATABRICKS_INTEGRATIONS=false
ENABLE_LOCAL_DEV_AUTH_FALLBACK=
LOCAL_DEV_USER_ID=local-dev-user
ENABLE_DOCS=true
SERVE_STATIC=false
FRONTEND_DIST_DIR=public
MAX_REQUEST_BODY_BYTES=1048576
MAX_UPLOAD_BYTES=52428800
KNOWLEDGE_ASSISTANT_ENDPOINT=
EXAMPLE_SECRET=
SUPERVISOR_MODEL=databricks-claude-sonnet-4-6
TURN_TIMEOUT_SECONDS=90
TOOL_TIMEOUT_SECONDS=45
MAX_CONCURRENT_TURNS=3
APP_AGENT_NAME=
SERVING_AGENT_ENDPOINT=
GENIE_SPACE_ID=
AI_GATEWAY_EMBEDDING_MODEL=
ENABLE_CHAT_TITLE_GENERATION=true
TITLE_MODEL=
MLFLOW_EXPERIMENT_ID=
SERVING_TIMEOUT_SECONDS=30
VECTOR_TIMEOUT_SECONDS=30
OPENAI_TIMEOUT_SECONDS=30
